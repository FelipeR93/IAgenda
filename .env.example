# Variáveis de ambiente para o IAgenda
# NUNCA commite o arquivo .env real no repositório!

# Modo de execução: development | production
NODE_ENV=development

# Porta do servidor (o Render define automaticamente via PORT)
PORT=3000

# Chave secreta das sessões (use uma string longa e aleatória em produção)
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=sua_chave_secreta_muito_longa_aqui

# URL de conexão com o PostgreSQL
# Em desenvolvimento local: postgresql://usuario:senha@localhost:5432/iagenda
# No Render: gerado automaticamente pelo serviço de banco de dados
DATABASE_URL=postgresql://usuario:senha@localhost:5432/iagenda

# Credenciais de acesso ao site
APP_LOGIN=felipe
# Hash bcrypt da senha "admin" (gerado com bcryptjs, custo 12)
# Gere com: node -e "const b=require('bcryptjs');b.hash('admin',12).then(h=>console.log(h))"
APP_PASSWORD_HASH=$2a$12$SUBSTITUA_PELO_HASH_GERADO_AQUI
