<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>IAgenda – Agenda</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="pagina-interna">

  <!-- Barra de navegação -->
  <nav class="navbar">
    <div class="nav-logo">📅 IAgenda</div>
    <div class="nav-links">
      <a href="/agenda" class="nav-link ativo">Agenda</a>
      <a href="/lista" class="nav-link">Lista</a>
    </div>
    <form action="/logout" method="POST" class="form-logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="btn-logout">Sair</button>
    </form>
  </nav>

  <!-- Conteúdo principal -->
  <main class="conteudo">
    <div class="calendario-wrapper">

      <!-- Cabeçalho do calendário -->
      <div class="calendario-cabecalho">
        <h2>ABRIL 2026</h2>
      </div>

      <!-- Grade do calendário -->
      <div class="calendario">
        <!-- Dias da semana -->
        <div class="dia-semana">DOM</div>
        <div class="dia-semana">SEG</div>
        <div class="dia-semana">TER</div>
        <div class="dia-semana">QUA</div>
        <div class="dia-semana">QUI</div>
        <div class="dia-semana">SEX</div>
        <div class="dia-semana">SÁB</div>

        <!-- Semana 1: Abril começa na Quarta-feira (índice 3) -->
        <div class="dia vazio"></div>
        <div class="dia vazio"></div>
        <div class="dia vazio"></div>
        <div class="dia">1</div>
        <div class="dia">2</div>
        <div class="dia">3</div>
        <div class="dia">4</div>

        <!-- Semana 2 -->
        <div class="dia">5</div>
        <div class="dia">6</div>
        <div class="dia">7</div>
        <div class="dia">8</div>
        <div class="dia">9</div>
        <div class="dia">10</div>
        <div class="dia">11</div>

        <!-- Semana 3 -->
        <div class="dia">12</div>
        <div class="dia">13</div>
        <div class="dia">14</div>
        <div class="dia">15</div>
        <div class="dia">16</div>
        <div class="dia">17</div>
        <div class="dia">18</div>

        <!-- Semana 4 -->
        <div class="dia">19</div>
        <div class="dia">20</div>
        <div class="dia">21</div>
        <div class="dia">22</div>
        <div class="dia">23</div>
        <div class="dia">24</div>
        <div class="dia">25</div>

        <!-- Semana 5 -->
        <div class="dia">26</div>
        <div class="dia">27</div>
        <div class="dia">28</div>
        <div class="dia">29</div>
        <div class="dia">30</div>
        <div class="dia vazio"></div>
        <div class="dia vazio"></div>
      </div>

    </div>
  </main>

</body>
</html>
